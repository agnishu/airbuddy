# Supabase project (Settings > API). Use the Mumbai (ap-south-1) region.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for the shared flight cache.
SUPABASE_SECRET_KEY=sb_secret_...

# AeroDataBox on RapidAPI, for flight lookups. Without it riders enter flight details by hand.
RAPIDAPI_KEY=

# Google Maps Platform key with Places API (New) enabled. Without it riders use their current location.
GOOGLE_MAPS_API_KEY=

# UPI ID that receives donations. Leave empty to hide the donation prompt.
NEXT_PUBLIC_UPI_ID=

# Optional: Uber developer client ID, added to "Book on Uber" links. The links work without it.
NEXT_PUBLIC_UBER_CLIENT_ID=
# Optional: Ola partner (XAPP) token. Ola requires it for booking links; without it only the Uber button shows.
NEXT_PUBLIC_OLA_XAPP_TOKEN=
