# Supabase project (Settings > API). Use the Mumbai (ap-south-1) region.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Used for the shared flight cache.
SUPABASE_SECRET_KEY=sb_secret_...

# AeroDataBox on RapidAPI, for flight lookups. Without it riders enter flight details by hand.
RAPIDAPI_KEY=

# Google Maps Platform key with Places API (New) enabled. Without it riders use their current location.
GOOGLE_MAPS_API_KEY=

# UPI ID that receives donations. Leave empty to hide the donation prompt.
NEXT_PUBLIC_UPI_ID=

# Phone login via Message Central VerifyNow (https://www.messagecentral.com). Server only.
VERIFYNOW_CUSTOMER_ID=
VERIFYNOW_PASSWORD=
# Domain for the stand-in email behind phone logins. It never receives mail.
PHONE_LOGIN_EMAIL_DOMAIN=phone.airbuddy.app
# Test numbers that skip SMS, as number:code pairs. Remove before launch.
OTP_TEST_NUMBERS=

# Cloudflare Turnstile bot check on the login form. Without it, only the rate limits apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
